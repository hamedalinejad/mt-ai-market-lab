{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mt-ai-market-lab/schemas/event-envelope.json",
  "title": "EventEnvelope",
  "type": "object",
  "required": [
    "event_id", "event_type", "event_version", "occurred_at_utc",
    "producer", "payload", "payload_schema_version"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "minLength": 1 },
    "event_version": { "type": "string" },
    "occurred_at_utc": { "type": "string", "format": "date-time" },
    "availability_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "correlation_id": { "type": ["string", "null"] },
    "causation_id": { "type": ["string", "null"] },
    "producer": { "type": "string" },
    "producer_version": { "type": ["string", "null"] },
    "entity_type": { "type": ["string", "null"] },
    "entity_id": { "type": ["string", "null"] },
    "payload": { "type": "object" },
    "payload_schema_version": { "type": "string" },
    "severity": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
